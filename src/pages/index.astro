    <script>
        const reduceMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
        ).matches

        // section headings draw their bar, then the red dot, once, as they
        // come into view; nothing moves for reduced motion
        if (!reduceMotion && 'IntersectionObserver' in window) {
            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('drawn')
                            observer.unobserve(entry.target)
                        }
                    }
                },
                { rootMargin: '0px 0px -12% 0px' }
            )
            document.documentElement.classList.add('reveal')
            document
                .querySelectorAll('main > :not(.jumbotron) > h2')
                .forEach((heading) => observer.observe(heading))
        }

        // terminals type their commands, once, as they come into view; the
        // page holds the full text, so without JavaScript or with reduced
        // motion they simply show it
        const terminals = document.querySelectorAll<HTMLElement>(
            '.terminal[data-typing]'
        )
        if (terminals.length && !reduceMotion && 'IntersectionObserver' in window) {
            const sleep = (ms: number) =>
                new Promise((resolve) => setTimeout(resolve, ms))
            const decode = (html: string) => {
                const area = document.createElement('textarea')
                area.innerHTML = html
                return area.value
            }
            // a typed line starts with its prompt: $ for the shell, > for the
            // agent (Astro adds its own attributes to the span)
            const typed = /^(<span class="(?:sh|ask)"[^>]*>[^<]*<\/span> )(.*)$/

            const play = async (code: HTMLElement, lines: string[], speed: number) => {
                const caret = document.createElement('span')
                caret.className = 'caret'
                for (let i = 0; i < lines.length; i++) {
                    if (i > 0) code.append('\n')
                    const line = document.createElement('span')
                    code.append(line)
                    const match = lines[i].match(typed)
                    if (match) {
                        line.innerHTML = match[1]
                        const text = document.createTextNode('')
                        line.append(text, caret)
                        await sleep(300)
                        for (const char of decode(match[2])) {
                            text.data += char
                            await sleep(speed)
                        }
                        await sleep(350)
                    } else {
                        line.innerHTML = lines[i]
                        line.append(caret)
                        if (lines[i]) await sleep(110)
                    }
                }
            }

            const observer = new IntersectionObserver(
                (entries) => {
                    for (const entry of entries) {
                        if (!entry.isIntersecting) continue
                        observer.unobserve(entry.target)
                        const terminal = entry.target as HTMLElement
                        const code = terminal.querySelector('code')!
                        play(
                            code,
                            JSON.parse(code.dataset.lines!),
                            Number(terminal.dataset.typing)
                        )
                    }
                },
                { threshold: 0.5 }
            )
            terminals.forEach((terminal) => {
                const pre = terminal.querySelector('pre')!
                const code = terminal.querySelector('code')!
                // keep the full height, so nothing below moves while it types
                pre.style.minHeight = `${pre.offsetHeight}px`
                code.dataset.lines = JSON.stringify(code.innerHTML.split('\n'))
                code.textContent = ''
                observer.observe(terminal)
            })
        }
    </script>
