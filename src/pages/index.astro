---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/variables.css'
import '../styles/index.css'
import Icon from '../components/Icon.astro'
import Carousel from '../components/Carousel.astro'
import CopyPage from '../components/CopyPage.astro'
import gallery from '../carousels/gallery.json'
import { Image } from 'astro:assets'
import browserIcons from '../assets/browser_icons.png'

const scaffoldCode = `npm create melonjs@latest my-game
cd my-game
npm install
npm run dev`

const helloCode = `<span class="kw">import</span> { Application, Text } <span class="kw">from</span> <span class="str">"melonjs"</span>;

<span class="cmt">// create a new melonJS application</span>
<span class="kw">const</span> app = <span class="kw">new</span> Application(<span class="num">1218</span>, <span class="num">562</span>, {
    parent: <span class="str">"screen"</span>,
    scale: <span class="str">"auto"</span>,
});

<span class="cmt">// initialize it (builds the renderer and appends the canvas)</span>
<span class="kw">await</span> app.init();

<span class="cmt">// add a text display object</span>
app.world.addChild(<span class="kw">new</span> Text(<span class="num">609</span>, <span class="num">281</span>, {
    font: <span class="str">"Arial"</span>,
    size: <span class="num">160</span>,
    fillStyle: <span class="str">"#FFFFFF"</span>,
    textBaseline: <span class="str">"middle"</span>,
    textAlign: <span class="str">"center"</span>,
    text: <span class="str">"Hello World !"</span>,
}));`
---

<BaseLayout
    title="melonJS | A Modern & Fully Featured HTML5 Game Engine"
    description="Build 2.5D games with melonJS, an open-source HTML5 engine. WebGPU, WebGL 2 or Canvas2D, GPU tilemaps, 3D mesh &amp; glTF scenes, Tiled, ~250 KB minzipped."
>
    <style>
        main {
            & h1,
            & h2,
            & h3,
            & h4,
            & h5,
            & h6 {
                margin-bottom: 1.5rem;
            }
            & > * {
                padding: var(--section-pad-y) var(--section-pad-x);
                &:nth-child(odd) {
                    background-color: var(--gray);
                    color: var(--white);
                    & h1,
                    & h2,
                    & h3,
                    & h4,
                    & h5,
                    & h6,
                    & a {
                        color: var(--light-green);
                    }
                }
                &:first-child {
                    & h1,
                    & h2,
                    & h3,
                    & h4,
                    & h5,
                    & h6,
                    & a {
                        color: var(--dark-green);
                    }
                }
            }
        }
    </style>
    <main>
        <div class="jumbotron">
            <div class="container">
                <Icon
                    icon="logo"
                    class="banner"
                    alt="melonjs banner"
                    width="80%"
                />
                <h1>A modern &amp; fully featured HTML5 game engine</h1>
                <p>
                    melonJS is an open-source 2.5D game engine for indie
                    developers: perspective and orthogonal cameras,
                    GPU-accelerated tilemap rendering, 3D mesh &amp; glTF
                    scenes, post-processing and custom shaders, and
                    polygon-accurate physics. Runs on <strong>WebGPU</strong>,
                    WebGL&nbsp;2 or Canvas2D with automatic fallback. The
                    whole engine is ~250&nbsp;KB minzipped of vanilla JS/TS,
                    with no dependencies and no toolchain lock-in.
                </p>
                <div class="badges">
                    <a href="https://www.npmjs.com/package/melonjs">
                        <img alt="npm version" src={`https://img.shields.io/npm/v/melonjs?style=flat-square&color=6ba832&label=npm`} height="20" />
                    </a>
                    <a href="https://github.com/melonjs/melonJS">
                        <img alt="GitHub stars" src={`https://img.shields.io/github/stars/melonjs/melonJS?style=flat-square&color=6ba832`} height="20" />
                    </a>
                    <a href="https://www.jsdelivr.com/package/npm/melonjs">
                        <img alt="jsDelivr hits" src={`https://img.shields.io/jsdelivr/npm/hm/melonjs?style=flat-square&color=6ba832&label=downloads`} height="20" />
                    </a>
                    <a href="https://github.com/melonjs/melonJS/blob/master/LICENSE">
                        <img alt="license MIT" src={`https://img.shields.io/badge/license-MIT-6ba832?style=flat-square`} height="20" />
                    </a>
                </div>
                <nav class="quick-start">
                    <ul>
                        <li>
                            <a
                                class="btn danger"
                                href="https://melonjs.github.io/melonJS/examples/#/platformer"
                                role="button"
                                ><Icon icon="film" inline />Demo
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn success"
                                href="/tutorial"
                                role="button"
                                ><Icon icon="flag" inline />Beginner's Tutorial
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn discord"
                                href="https://discord.gg/aur7JMk"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Icon icon="discord" class="inline" />Chat with
                                Us
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn default"
                                href="https://melonjs.github.io/melonJS/"
                                role="button"
                                ><Icon icon="book-open" inline />Explore the API
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn primary"
                                href="https://melonjs.github.io/melonJS/examples/"
                                role="button"
                                ><Icon icon="film" inline />Examples
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
        <div class="row three highlights">
            <div>
                <h2>Fast</h2>
                <p>Modern ES6 architecture. WebGPU and WebGL&nbsp;2 renderers with Canvas fallback. Web Audio with 3D spatial sound.</p>
            </div>
            <div>
                <h2>Free</h2>
                <p>Released under the permissive MIT License. No cost. Forever.</p>
            </div>
            <div>
                <h2>Standalone</h2>
                <p>
                    Zero dependencies. Compatible with all major browsers
                    and mobile devices. ~250&nbsp;KB
                    <a href="https://bundlejs.com/?q=melonjs">minzipped</a>,
                    with no toolchain lock-in.
                </p>
            </div>
        </div>

        <div class="why-section">
            <h2 id="why">Why melonJS?</h2>
            <p class="why-lead">
                melonJS is designed so you can focus on making games, not on graphics plumbing.
            </p>
            <div class="why-cards">
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Canvas2D-Inspired API</h3>
                    <p>
                        If you've used the HTML5 Canvas, you already know melonJS. The rendering API
                        (<code>save</code>, <code>restore</code>, <code>translate</code>, <code>rotate</code>, <code>setColor</code>, <code>fillRect</code>, ...)
                        follows the same familiar patterns. No render graphs, no shader pipelines, no instruction sets to learn.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>WebGPU, WebGL 2 or Canvas2D</h3>
                    <p>
                        Write your game once, run it on any backend with zero code changes. The default
                        <code>AUTO</code> mode tries <strong>WebGPU</strong> first, falls back to WebGL&nbsp;2, and
                        ultimately to Canvas, and the entire feature set renders identically on both GPU
                        backends.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Complete Engine, Minimal Footprint</h3>
                    <p>
                        Physics, tilemaps, audio, input, cameras, tweens, particles, UI: a full game stack
                        in a single ES module. No dependency sprawl, no library stitching.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Scenes, Loaded in One Call</h3>
                    <p>
                        <code>level.load(name)</code> brings an authored scene straight into your world.
                        <a href="https://www.mapeditor.org">Tiled</a> is a first-class citizen for 2D, and
                        <strong>glTF / GLB</strong> is its equivalent for <strong>3D</strong>: author in Blender,
                        export a <code>.glb</code>, and the whole scene (meshes, materials, cameras,
                        lights and node animation) loads under a <code>Camera3d</code>.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Batteries Included</h3>
                    <p>
                        Get started in minutes with minimal setup. Sprites, animations, 3D meshes with dynamic
                        lighting and ground shadows, built-in &amp; custom shaders, spatial audio and particle
                        effects, ready to use out of the box.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Hackable by Design</h3>
                    <p>
                        ES6 classes throughout, a plugin system for engine extensions, and a clean architecture
                        that's easy to extend without fighting the framework. Go as deep as you need.
                    </p>
                </div>
            </div>
        </div>

        <div class="band">
            <h2>Powerful Level Design</h2>
            <p>
                Design your levels visually with the
                <a href="https://www.mapeditor.org">Tiled</a> map editor.
                melonJS natively supports orthogonal, isometric, and hexagonal
                maps with multiple layers, parallax scrolling, and more.
            </p>
            <br />
            <img
                src="/img/alex4-github.png"
                alt="melonJS level design with Tiled map editor showing platformer game"
                title="Fast and Powerful level design through Tiled"
                width="85%"
                height="85%"
                class="computer"
            />
        </div>

        <div>
            <h2 id="try-it">Try it Live</h2>
            <p>Jump right into a melonJS game, playable in your browser.</p>
            <div class="demo-embed">
                <iframe
                    src="https://melonjs.github.io/melonJS/examples/#/platformer"
                    title="melonJS platformer demo"
                    loading="lazy"
                    allowfullscreen
                ></iframe>
            </div>
        </div>

        <div>
            <h2 id="get-started">Get Started in Seconds</h2>
            <p>Scaffold a new project with a single command:</p>
            <pre class="code-block"><code set:html={scaffoldCode} /></pre>
            <p>Or use the API directly for a quick Hello World:</p>
            <pre class="code-block"><code set:html={helloCode} /></pre>
        </div>

        <div class="ai-section">
            <div class="ai-head">
                <h2 id="ai-assistants">Working with an AI assistant</h2>
                <CopyPage />
            </div>
            <p class="ai-lead">
                An assistant with nothing to read invents API names. These
                three give it the real ones.
            </p>
            <div class="why-cards">
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>llms.txt</h3>
                    <p>
                        <a href="https://melonjs.github.io/melonJS/llms.txt"
                            >llms.txt</a
                        > indexes every exported class, function, interface and
                        type with a one-line summary, a link to its page, and a
                        marker on the deprecated ones. It is regenerated on
                        every docs build, so it never drifts from the release.
                        Hand an assistant that one URL instead of letting it
                        guess.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Skills</h3>
                    <p>
                        melonJS ships guidance files that teach an assistant the
                        engine's conventions, and more usefully the mistakes
                        that fail silently rather than erroring: a custom
                        <code>draw()</code> that ignores <code>this.pos</code>,
                        <code>isKinematic</code> blocking pointer events,
                        <code>.z</code> set after <code>addChild</code>.
                    </p>
                    <pre class="code-block wrap"><code>npx skills add https://github.com/melonjs/melonJS/tree/master/packages/melonjs/skills</code></pre>
                    <p>
                        That installs 23 skills in whatever layout your agent
                        expects (<code>.claude/skills/</code>, <code
                            >.agents/skills/</code
                        >, <code>.windsurf/skills/</code> and around seventy
                        others), so nothing is placed by hand. It installs from
                        <code>master</code>; the copy matching a specific
                        release ships inside the npm package at <code
                            >node_modules/melonjs/skills/</code
                        >.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Copy page</h3>
                    <p>
                        The <strong>Copy page</strong> control above takes this
                        page as Markdown with its URL attached, ready to paste
                        into an assistant that cannot browse the web. It can
                        also open a new chat in ChatGPT or Claude with the URL
                        already filled in.
                    </p>
                </div>
            </div>
        </div>

        <div class="stack">
            <div>
                <h2 id="features">Features</h2>
                <ul>
                    <li>Fast <strong>WebGPU</strong> &amp; <strong>WebGL&nbsp;2</strong> renderers across desktop and mobile, with automatic fallback to Canvas</li>
                    <li><strong>GPU-accelerated tile rendering</strong> for orthogonal Tiled maps on both GPU backends: one quad per layer, no per-tile loop</li>
                    <li>Optional <strong>perspective camera</strong> (<code>Camera3d</code>) with frustum culling for 2.5D / 3D-projected scenes</li>
                    <li><strong>3D mesh rendering</strong> with OBJ/MTL loading, multi-material support, and hardware depth testing</li>
                    <li><strong>glTF / GLB 3D scenes</strong> loaded with a single <code>level.load()</code>: meshes, materials, cameras, lights and node animation, played through the same API as a 2D <code>Sprite</code></li>
                    <li><strong>3D lighting</strong> (<code>Light3d</code> directional, point, spot &amp; ambient, up to 32 lights) with ground shadows on by default</li>
                    <li><strong><code>Light2d</code></strong> as a first-class renderable: multi-light, radial-gradient falloff, illumination-only mode, normal-map sprite shading</li>
                    <li>Per-camera <strong>post-processing</strong> with stackable shader effects (Flash, Outline, Glow, CRT, Hologram, ColorMatrix) and custom <code>ShaderEffect</code> per-sprite fragment effects (GLSL and/or WGSL)</li>
                    <li>Physics: polygon SAT collision, QuadTree/Octree broad-phase (auto-swapped 2D&#8596;3D), 2D &amp; 3D raycasts, plus pluggable adapters (<a href="https://www.npmjs.com/package/@melonjs/matter-adapter">Matter</a> / <a href="https://www.npmjs.com/package/@melonjs/planck-adapter">Planck</a>)</li>
                    <li>Full <a href="https://www.mapeditor.org">Tiled</a> map editor integration, with every feature supported (any map format, animated tilesets, custom properties, parallax layers, native <code>.aseprite</code> tilesets)</li>
                    <li>Web Audio with 3D spatial sound, stereo panning, and procedural audio primitives (oscillators, noise) for SFX without sample assets</li>
                    <li>Multi-input: mouse, touch, keyboard, gamepad &amp; accelerometer</li>
                    <li>UI toolkit with drag-and-drop, hover/press buttons, and bitmap-font text</li>
                    <li>Tweens, transitions &amp; particle effects</li>
                    <li><a href="https://www.npmjs.com/package/@melonjs/spine-plugin">Spine 4.3</a> runtime integration via the official plugin</li>
                    <li>State manager, asset loader &amp; plugin system</li>
                    <li>
                        ~250&nbsp;KB <a
                            href="https://bundlejs.com/?q=melonjs"
                        >minzipped</a>, zero dependencies
                    </li>
                </ul>
            </div>

            <div class="compat">
                <Image
                    class="right no-mobile"
                    width={150}
                    src={browserIcons}
                    alt="Chrome, Firefox and Safari logos"
                />
                <h2 id="compatible">Compatibility</h2>
                <p>Compatible with all major browsers and mobile devices.</p>
                <p>
                    The published bundle targets <strong>ES2022</strong>. A
                    browser that does not support it cannot parse the file at
                    all: loading fails with a syntax error and a blank screen,
                    rather than breaking later when some feature runs.
                </p>
                <p>
                    To support older browsers, transpile melonJS together with
                    your own code. See <a
                        href="https://github.com/melonjs/melonJS#supporting-older-browsers"
                        >Supporting older browsers</a
                    > in the README.
                </p>
            </div>
        </div>

        <div>
            <h2>Developer Spotlight</h2>
            <div class="spotlight">
                <Carousel entries={gallery} />
            </div>
        </div>

        <div>
            <h2 id="third-party">Third Party Tools Integration</h2>
            <p>melonJS provides native integration and support for the following 3rd party tools:</p>
            <ul class="display">
                <li>
                    <a href="https://www.mapeditor.org">
                        <img
                            alt="Tiled map editor"
                            src="https://user-images.githubusercontent.com/4033090/136762999-5a7f377b-4136-4205-9fe0-83728c90cb9b.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://www.codeandweb.com/texturepacker">
                        <img
                            alt="TexturePacker"
                            src="https://github.com/melonjs/melonJS/raw/master/media/icons/texturepacker.svg"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://www.codeandweb.com/spriteilluminator">
                        <img
                            alt="SpriteIlluminator"
                            src="https://github.com/melonjs/melonJS/raw/master/media/icons/spriteilluminator.svg"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://free-tex-packer.com">
                        <img
                            alt="Free Texture packer"
                            src="https://user-images.githubusercontent.com/4033090/136762061-1d3a0dfe-dbe0-4d3d-808d-47a49ecf5309.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://www.codeandweb.com/physicseditor">
                        <img
                            alt="Physics Editor"
                            src="https://github.com/melonjs/melonJS/raw/master/media/icons/physicseditor.svg"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://renderhjs.net/shoebox/">
                        <img
                            alt="Shoebox"
                            src="https://user-images.githubusercontent.com/4033090/136762705-92027d94-d87c-4a95-b051-26647410248d.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://cordova.apache.org">
                        <img
                            alt="Cordova"
                            src="https://user-images.githubusercontent.com/4033090/136763147-6d157ce6-6921-437e-bb8f-0287b86109da.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://capacitorjs.com">
                        <img alt="Capacitor" src="https://github.com/melonjs/melonJS/raw/master/media/icons/capacitor.svg">
                    </a>
                </li>
                <li>
                    <a href="http://esotericsoftware.com/">
                        <img alt="Spine" src="https://user-images.githubusercontent.com/4033090/261166742-7a8d81b8-bc80-47bd-80dc-d9a054c78c96.png">
                    </a>
                </li>
                <li>
                    <a href="https://www.aseprite.org/">
                        <img alt="aseprite" src="https://github.com/melonjs/melonJS/assets/4033090/65d19fef-2eba-461a-b925-cc2ad3bb270c">
                    </a>
                </li>
            </ul>
        </div>
        <footer class="band">
            <ul class="socials">
                <li>
                    <a
                        aria-label="NPM"
                        href="https://www.npmjs.com/package/melonjs"
                        ><Icon icon="npm" alt="npm" class="inline no-bump" />
                    </a>
                </li>
                <li>
                    <a href="https://discord.gg/aur7JMk" target="_blank" rel="noopener noreferrer"
                        ><Icon icon="discord" class="inline" />
                    </a>
                </li>
                <li>
                    <a href="https://github.com/melonjs/melonJS"
                        ><Icon icon="github" class="inline" /><span> </span>
                    </a>
                </li>
            </ul>
            <p>&#169; AltByte Pte Ltd</p>
            <p>
                <a href="https://www.altbyte.com"
                    ><img
                        src="https://user-images.githubusercontent.com/4033090/136692693-35dca8aa-5012-4a37-9ea2-51640d2e6d73.png"
                        alt="AltByte"
                        height="32"
                    /></a
                >
            </p>
        </footer>
    </main>
</BaseLayout>
