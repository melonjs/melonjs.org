---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/variables.css'
import '../styles/index.css'
import Icon from '../components/Icon.astro'
import Carousel from '../components/Carousel.astro'
import gallery from '../carousels/gallery.json'
---

<BaseLayout>
    <style>
        main {
            & h1,
            & h2,
            & h3,
            & h4,
            & h5,
            & h6 {
                margin-bottom: 5vmin;
            }
            & > * {
                padding: 5vmin 20vmin;
                @media (max-width: 640px) {
                    padding: 5vmin 10vmin;
                }
                &:nth-child(odd) {
                    background-color: var(--gray);
                    color: var(--white);
                    & h1,
                    & h2,
                    & h3,
                    & h4,
                    & h5,
                    & h6,
                    & a {
                        color: var(--light-green);
                    }
                }
                &:first-child {
                    & h1,
                    & h2,
                    & h3,
                    & h4,
                    & h5,
                    & h6,
                    & a {
                        color: var(--dark-green);
                    }
                }
            }
        }
    </style>
    <main>
        <div class="jumbotron">
            <div class="container">
                <Icon
                    icon="logo"
                    class="banner"
                    alt="melonjs banner"
                    width="80%"
                />
                <h1>A modern &amp; lightweight HTML5 game engine</h1>
                <p>
                    melonJS is an open-source HTML5 game engine for building
                    2D games with JavaScript and TypeScript. Lightweight,
                    dependency-free, and fully tree-shakeable.
                </p>
                <nav class="quick-start">
                    <ul>
                        <li>
                            <a
                                class="btn danger"
                                href="https://melonjs.github.io/examples/platformer/"
                                role="button"
                                ><Icon icon="film" inline />Demo
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn success"
                                href="/tutorial"
                                role="button"
                                ><Icon icon="flag" inline />Beginner's Tutorial
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn discord"
                                href="https://discord.gg/aur7JMk"
                                target="_blank"
                            >
                                <Icon icon="discord" class="inline" />Chat with
                                Us
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn default"
                                href="https://melonjs.github.io/melonJS/"
                                role="button"
                                ><Icon icon="book-open" inline />Explore the API
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn primary"
                                href="https://github.com/melonjs/melonJS/releases"
                                role="button"
                                ><Icon icon="download" inline />Download
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
        <div class="row three highlights">
            <div>
                <h2>Fast</h2>
                <p>ES6 classes &amp; tree-shaking. WebGL renderer with Canvas fallback. Web Audio with 3D spatial sound.</p>
            </div>
            <div>
                <h2>Free</h2>
                <p>Released under the permissive MIT License. No cost. Forever.</p>
            </div>
            <div>
                <h2>Standalone</h2>
                <p>
                    Zero dependencies. Compatible with all major browsers
                    and mobile devices. Under
                    <a href="https://bundlephobia.com/result?p=melonjs@latest">100kb</a>
                    gzipped.
                </p>
            </div>
        </div>

        <div class="band">
            <h2>Powerful Level Design</h2>
            <p>
                Design your levels visually with the
                <a href="https://www.mapeditor.org">Tiled</a> map editor.
                melonJS natively supports orthogonal, isometric, and hexagonal
                maps with multiple layers, parallax scrolling, and more.
            </p>
            <br />
            <img
                src="/img/alex4-github.png"
                title="Fast and Powerful level design through Tiled"
                width="85%"
                height="85%"
                class="computer"
            />
        </div>

        <div class="row two">
            <div>
                <h2 id="features">
                    <a href="/#features" class="anchor">Features</a>
                </h2>
                <hr />
                <ul>
                    <li>Fast WebGL &amp; Canvas rendering across desktop and mobile</li>
                    <li>Web Audio with 3D spatial sound</li>
                    <li>Sprites, animations, tinting, masking &amp; 2D lighting</li>
                    <li>Built-in 2D physics &amp; collision detection</li>
                    <li>Tiled map editor integration (orthogonal, isometric, hexagonal)</li>
                    <li>Multi-input: mouse, touch, keyboard, gamepad &amp; accelerometer</li>
                    <li>Camera system with effects (shake, fade, flash)</li>
                    <li>UI toolkit with drag-and-drop support</li>
                    <li>Tweens, transitions &amp; particle effects</li>
                    <li>State manager, asset loader &amp; plugin system</li>
                    <li>
                        Under <a
                            href="https://bundlephobia.com/result?p=melonjs@latest"
                        >100kb</a> gzipped &mdash; zero dependencies
                    </li>
                </ul>
            </div>

            <div>
                <img
                    class="right no-mobile"
                    width="150"
                    src="/img/icons/browser_icons.png"
                    alt="browser icons example"
                />
                <h2 id="compatible">
                    <a href="/#compatible" class="anchor">Compatibility</a>
                </h2>
                <hr />
                <p>Compatible with all major browsers and mobile devices</p>
                <table class="table browsers">
                    <thead>
                        <tr><th>Browser</th><th>Version</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th>
                                <a href="https://www.google.com/chrome/"
                                    >Chrome / Edge
                                </a>
                            </th>
                            <td>80+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th
                                ><a href="https://www.mozilla.com/">Firefox</a>
                            </th>
                            <td>80+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th
                                ><a href="https://www.apple.com/safari/"
                                    >Safari
                                </a>
                            </th>
                            <td>14+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th><a href="https://www.opera.com/">Opera</a></th>
                            <td>67+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th
                                ><a
                                    href="https://www.google.com/chrome/browser/mobile/"
                                    >Chrome Mobile
                                </a>
                            </th>
                            <td>80+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th
                                ><a href="https://www.apple.com/safari/"
                                    >iOS Safari
                                </a>
                            </th>
                            <td>14+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <h2>Developer Spotlight</h2>
            <div class="spotlight">
                <Carousel entries={gallery} />
            </div>
        </div>

        <div>
            <h3 id="third-party">
                <a href="/#third-party" class="anchor"
                    >Third Party Tools Integration</a
                >
            </h3>
            <hr />
            melonJS provides native integration and support for the following 3rd
            party tools :
            <br />
            <ul class="display">
                <li>
                    <a href="https://www.mapeditor.org">
                        <img
                            alt="Tiled map editor"
                            src="https://user-images.githubusercontent.com/4033090/136762999-5a7f377b-4136-4205-9fe0-83728c90cb9b.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://www.codeandweb.com/texturepacker">
                        <img
                            alt="TexturePacker"
                            src="https://user-images.githubusercontent.com/4033090/136762472-bc55a638-c69b-4ff5-9d03-c684c8bea0ea.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://free-tex-packer.com">
                        <img
                            alt="Free Texture packer"
                            src="https://user-images.githubusercontent.com/4033090/136762061-1d3a0dfe-dbe0-4d3d-808d-47a49ecf5309.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://www.codeandweb.com/physicseditor">
                        <img
                            alt="Physics Editor"
                            src="https://user-images.githubusercontent.com/4033090/136762890-b1010c7f-cb19-4d35-a3f1-f5048db07835.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://renderhjs.net/shoebox/">
                        <img
                            alt="Shoebox"
                            src="https://user-images.githubusercontent.com/4033090/136762705-92027d94-d87c-4a95-b051-26647410248d.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://cordova.apache.org">
                        <img
                            alt="Cordova"
                            src="https://user-images.githubusercontent.com/4033090/136763147-6d157ce6-6921-437e-bb8f-0287b86109da.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="http://esotericsoftware.com/">
                        <img alt="Spine" src="https://user-images.githubusercontent.com/4033090/261166742-7a8d81b8-bc80-47bd-80dc-d9a054c78c96.png">
                    </a>
                </li>
                <li>
                    <a href="https://www.aseprite.org/">
                        <img alt="aseprite" src="https://github.com/melonjs/melonJS/assets/4033090/65d19fef-2eba-461a-b925-cc2ad3bb270c">
                    </a>
                </li>
            </ul>
        </div>
        <footer class="band">
            <ul class="socials">
                <li>
                    <a
                        aria-label="NPM"
                        href="https://www.npmjs.com/package/melonjs"
                        ><Icon icon="npm" alt="npm" class="inline no-bump" />
                    </a>
                </li>
                <li>
                    <a href="https://discord.gg/aur7JMk" target="_blank"
                        ><Icon icon="discord" class="inline" />
                    </a>
                </li>
                <li>
                    <a href="https://github.com/melonjs/melonJS"
                        ><Icon icon="github" class="inline" /><span> </span>
                    </a>
                </li>
            </ul>
            <p>&#169; AltByte Pte Ltd</p>
            <p>
                <a href="https://www.altbyte.com"
                    ><img
                        src="https://user-images.githubusercontent.com/4033090/136692693-35dca8aa-5012-4a37-9ea2-51640d2e6d73.png"
                        alt="AltByte"
                        height="32"
                    /></a
                >
            </p>
        </footer>
    </main>
</BaseLayout>
