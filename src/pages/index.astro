---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/variables.css'
import '../styles/index.css'
import Icon from '../components/Icon.astro'
import Carousel from '../components/Carousel.astro'
import gallery from '../carousels/gallery.json'
import { Image } from 'astro:assets'
import browserIcons from '../assets/browser_icons.png'
import hero from '../assets/hero.webp'
import exPlatformer from '../assets/examples/platformer.webp'
import exDungeon from '../assets/examples/isometric-dungeon.webp'
import exRabbit from '../assets/examples/jungle-rabbit.webp'
import exEarth from '../assets/examples/earth-defender.webp'
import exAquarium from '../assets/examples/aquarium.webp'
import exPool from '../assets/examples/pool-matter.webp'

// See It in Action: a few examples across 2D, 3D, shaders and physics
const examples = [
    {
        path: 'platformer',
        title: 'Platformer',
        image: exPlatformer,
        tags: ['2D', 'Tiled', 'Physics'],
        text: 'A side-scroller with tile collisions, enemies, particles, shaders and a minimap.',
    },
    {
        path: 'isometric-dungeon',
        title: 'Isometric Dungeon',
        image: exDungeon,
        tags: ['2D', 'Tiled', 'Lighting'],
        text: 'A big isometric dungeon: depth-sorted walls, flickering torches, chests and doors.',
    },
    {
        path: 'jungle-rabbit',
        title: 'Jungle Rabbit',
        image: exRabbit,
        tags: ['3D', 'Blender'],
        text: 'A low-poly river runner, its props modelled in Blender and drawn with GPU instancing.',
    },
    {
        path: 'earth-defender',
        title: 'Earth Defender',
        image: exEarth,
        tags: ['3D', 'Shaders', 'HDR'],
        text: 'Hold the dome, shoot the rocks: shield shaders, spatial audio and HDR bloom.',
    },
    {
        path: 'aquarium',
        title: 'Aquarium',
        image: exAquarium,
        tags: ['2D', 'Shaders'],
        text: 'Fish rippled through the live scene by a screen-space refraction shader.',
    },
    {
        path: 'pool-matter',
        title: 'Pool',
        image: exPool,
        tags: ['Physics', 'Matter'],
        text: 'Eight-ball pool on the Matter physics adapter: drag to aim, release to strike.',
    },
]

const helloCode = `<span class="kw">import</span> { Application, Text } <span class="kw">from</span> <span class="str">"melonjs"</span>;

<span class="cmt">// create a new melonJS application</span>
<span class="kw">const</span> app = <span class="kw">new</span> Application(<span class="num">1218</span>, <span class="num">562</span>, {
    parent: <span class="str">"screen"</span>,
    scale: <span class="str">"auto"</span>,
});

<span class="cmt">// initialize it (builds the renderer and appends the canvas)</span>
<span class="kw">await</span> app.init();

<span class="cmt">// add a text display object</span>
app.world.addChild(<span class="kw">new</span> Text(<span class="num">609</span>, <span class="num">281</span>, {
    font: <span class="str">"Arial"</span>,
    size: <span class="num">160</span>,
    fillStyle: <span class="str">"#FFFFFF"</span>,
    textBaseline: <span class="str">"middle"</span>,
    textAlign: <span class="str">"center"</span>,
    text: <span class="str">"Hello World !"</span>,
}));`
---

<BaseLayout
    title="melonJS | A Modern & Fully Featured HTML5 Game Engine"
    description="melonJS is a free, open-source 2D &amp; 3D HTML5 game engine for indie developers, since 2011: WebGPU, WebGL 2 or Canvas, Tiled &amp; glTF scenes, physics, ~250 KB minzipped."
>
    <style>
        main {
            background-color: var(--dark-gray);

            & h1,
            & h2,
            & h3,
            & h4,
            & h5,
            & h6 {
                margin-bottom: 1.5rem;
            }

            /* backgrounds stay full-bleed; only the content is held to a
               readable measure */
            & > * {
                padding: var(--section-pad-y)
                    max(
                        var(--section-pad-x),
                        calc((100% - var(--measure)) / 2)
                    );

                /* sections still alternate, but as a tonal step rather than
                   a stripe */
                &:nth-child(even) {
                    background-color: var(--gray);
                    border-block: 1px solid rgba(255, 255, 255, 0.05);
                }
            }

            & > *:not(.jumbotron) > h2 {
                position: relative;
                padding-top: 1rem;

                /* the brand's green bar, then its red dot */
                &::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 3rem;
                    height: 3px;
                    border-radius: 2px;
                    background: var(--dark-green);
                }

                &::after {
                    content: '';
                    position: absolute;
                    top: -1px;
                    left: calc(3rem + 6px);
                    width: 5px;
                    height: 5px;
                    border-radius: 50%;
                    background: var(--melon);
                }
            }
        }
    </style>
    <main>
        <div class="jumbotron">
            <div class="container">
                <Image
                    class="hero"
                    src={hero}
                    widths={[750, 1200, 1800, 2250]}
                    sizes="(min-width: 1240px) 1180px, 100vw"
                    alt="melonJS: fast & light 2D & 3D games for the web, running on WebGPU, WebGL 2 or Canvas. Author in Tiled and Blender, ship anywhere."
                    loading="eager"
                    fetchpriority="high"
                />
                <h1 class="sr-only">A modern &amp; fully featured HTML5 game engine</h1>
                <p>
                    melonJS is an open-source 2D &amp; 3D game engine made
                    for indie developers, and one of the very first HTML5
                    game engines: first released in 2011, it has grown with
                    the web ever since. Perspective and orthogonal cameras,
                    GPU-accelerated tilemaps, 3D meshes &amp; glTF scenes,
                    post-processing and custom shaders, polygon-accurate
                    physics. Runs on <strong>WebGPU</strong>, WebGL&nbsp;2 or
                    Canvas2D with automatic fallback, in ~250&nbsp;KB
                    minzipped of vanilla JS/TS, with no dependencies and no
                    toolchain lock-in.
                </p>
                <div class="badges">
                    <a href="https://www.npmjs.com/package/melonjs">
                        <img alt="npm version" src={`https://img.shields.io/npm/v/melonjs?style=flat-square&color=6ba832&label=npm`} height="20" />
                    </a>
                    <a href="https://github.com/melonjs/melonJS">
                        <img alt="GitHub stars" src={`https://img.shields.io/github/stars/melonjs/melonJS?style=flat-square&color=6ba832`} height="20" />
                    </a>
                    <a href="https://www.jsdelivr.com/package/npm/melonjs">
                        <img alt="jsDelivr hits" src={`https://img.shields.io/jsdelivr/npm/hm/melonjs?style=flat-square&color=6ba832&label=downloads`} height="20" />
                    </a>
                    <a href="https://github.com/melonjs/melonJS/blob/master/LICENSE">
                        <img alt="license MIT" src={`https://img.shields.io/badge/license-MIT-6ba832?style=flat-square`} height="20" />
                    </a>
                </div>
                <nav class="quick-start">
                    <ul>
                        <li>
                            <a
                                class="btn danger"
                                href="https://melonjs.github.io/melonJS/examples/"
                                role="button"
                                ><Icon icon="film" inline />Examples
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn success"
                                href="/tutorial"
                                role="button"
                                ><Icon icon="flag" inline />Beginner's Tutorial
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn discord"
                                href="https://discord.gg/aur7JMk"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Icon icon="discord" class="inline" />Chat with
                                Us
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn default"
                                href="https://melonjs.github.io/melonJS/"
                                role="button"
                                ><Icon icon="book-open" inline />Explore the API
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>

        <div class="why-section">
            <h2 id="why">Why melonJS?</h2>
            <p class="why-lead">
                melonJS is designed so you can focus on making games, not on graphics plumbing.
            </p>
            <div class="why-cards">
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Canvas2D-Inspired API</h3>
                    <p>
                        If you've used the HTML5 Canvas, you already know melonJS. The rendering API
                        (<code>save</code>, <code>restore</code>, <code>translate</code>, <code>rotate</code>, <code>setColor</code>, <code>fillRect</code>, ...)
                        follows the same familiar patterns. No render graphs, no shader pipelines, no instruction sets to learn.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>WebGPU, WebGL 2 or Canvas2D</h3>
                    <p>
                        Write your game once, run it on any backend with zero code changes. The default
                        <code>AUTO</code> mode tries <strong>WebGPU</strong> first, falls back to WebGL&nbsp;2, and
                        ultimately to Canvas, and the entire feature set renders identically on both GPU
                        backends.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Complete Engine, Minimal Footprint</h3>
                    <p>
                        Physics, tilemaps, audio, input, cameras, tweens, particles, UI: a full game stack
                        in a single ES module. No dependency sprawl, no library stitching.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Scenes, Loaded in One Call</h3>
                    <p>
                        <code>level.load(name)</code> brings an authored scene straight into your world.
                        <a href="https://www.mapeditor.org">Tiled</a> is a first-class citizen for 2D, and
                        <strong>glTF / GLB</strong> is its equivalent for <strong>3D</strong>: author in Blender,
                        export a <code>.glb</code>, and the whole scene (meshes, materials, cameras,
                        lights and node animation) loads under a <code>Camera3d</code>.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Batteries Included</h3>
                    <p>
                        Get started in minutes with minimal setup. Sprites, animations, 3D meshes with dynamic
                        lighting and ground shadows, built-in &amp; custom shaders, spatial audio and particle
                        effects, ready to use out of the box.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Hackable by Design</h3>
                    <p>
                        ES6 classes throughout, a plugin system for engine extensions, and a clean architecture
                        that's easy to extend without fighting the framework. Go as deep as you need.
                    </p>
                </div>
            </div>
        </div>


        <div>
            <h2 id="features">Features</h2>
            <div class="feature-groups">
                <div>
                    <h3>Rendering</h3>
                    <ul>
                        <li><strong>WebGPU</strong> &amp; <strong>WebGL&nbsp;2</strong> renderers across desktop and mobile, with automatic fallback to Canvas</li>
                        <li><strong>GPU-accelerated tile rendering</strong> for orthogonal Tiled maps: one quad per layer, no per-tile loop</li>
                        <li><strong>Shader effects</strong> on sprites, cameras and meshes: Flash, Outline, Glow, Bloom, Dissolve, CRT, Hologram, Shine, Vignette, Squish, Sway and more, chained with <code>addPostEffect()</code></li>
                        <li>Your own <code>ShaderEffect</code> in GLSL and/or WGSL, and optional HDR rendering</li>
                        <li>Particles, trails, tweens and video sprites</li>
                    </ul>
                </div>
                <div>
                    <h3>3D</h3>
                    <ul>
                        <li>Optional <strong>perspective camera</strong> (<code>Camera3d</code>) with frustum culling and distance fog</li>
                        <li><code>Sprite3d</code> billboards for 2.5D characters and props</li>
                        <li><strong>3D meshes</strong> from OBJ/MTL or glTF, with normal maps, transparency, depth testing and GPU instancing (<code>InstancedMesh</code>)</li>
                        <li><strong>glTF / GLB scenes</strong>, authored in <a href="https://www.blender.org">Blender</a> or any glTF tool, loaded with a single <code>level.load()</code>: meshes, materials, cameras, lights and node animation</li>
                    </ul>
                </div>
                <div>
                    <h3>Lighting &amp; Cameras</h3>
                    <ul>
                        <li><code>Light2d</code> with normal-map sprite shading</li>
                        <li><code>Light3d</code> directional, point, spot &amp; ambient lights (up to 32), with ground shadows on by default</li>
                        <li>Multiple cameras (split-screen, minimaps), camera follow, shake and fade, and screen transitions</li>
                    </ul>
                </div>
                <div>
                    <h3>Physics</h3>
                    <ul>
                        <li>Polygon SAT collision, QuadTree/Octree broad-phase, 2D &amp; 3D raycasts</li>
                        <li>Sensors, and bodies with several shapes</li>
                        <li>Three official adapters, <a href="https://www.npmjs.com/package/@melonjs/matter-adapter">Matter</a>, <a href="https://www.npmjs.com/package/@melonjs/planck-adapter">Planck</a> and <a href="https://www.npmjs.com/package/@melonjs/rapier2d-adapter">Rapier</a>, switched while the game runs, with hinge, rope, weld and slider joints</li>
                    </ul>
                </div>
                <div>
                    <h3>Audio, Input &amp; UI</h3>
                    <ul>
                        <li>Web Audio with 3D spatial sound, stereo panning, audio sprites and procedural SFX</li>
                        <li>Mouse, touch, keyboard, gamepad &amp; accelerometer, and on-screen touch controls that play as a gamepad (<a href="https://www.npmjs.com/package/@melonjs/gamepad-plugin">gamepad plugin</a>)</li>
                        <li>UI toolkit: buttons, scrolling panels, checkboxes, sliders, progress bars and drag-and-drop, all navigable with the keyboard or a gamepad</li>
                        <li>System &amp; bitmap text with typewriter and per-glyph effects</li>
                    </ul>
                </div>
                <div>
                    <h3>Workflow</h3>
                    <ul>
                        <li>Full <a href="https://www.mapeditor.org">Tiled</a> integration, up to Tiled 1.12: any map format and orientation, animated tilesets, custom properties, parallax layers, native <code>.aseprite</code> tilesets</li>
                        <li><a href="https://www.npmjs.com/package/@melonjs/spine-plugin">Spine 4.3</a> runtime integration via the official plugin</li>
                        <li>Saved progress in <code>localStorage</code>, or in a platform's cloud save</li>
                        <li>State manager, asset loader &amp; plugin system</li>
                        <li>~250&nbsp;KB <a href="https://bundlejs.com/?q=melonjs">minzipped</a>, zero dependencies</li>
                    </ul>
                </div>
            </div>
        </div>

        <div>
            <h2 id="see-it-in-action">See It in Action</h2>
            <p>
                Every example runs in your browser, with its source one click
                away.
            </p>
            <ul class="examples-grid">
                {
                    examples.map((example) => (
                        <li>
                            <a
                                href={`https://melonjs.github.io/melonJS/examples/#/${example.path}`}
                            >
                                <Image
                                    src={example.image}
                                    widths={[480, 960]}
                                    sizes="(min-width: 1080px) 380px, (min-width: 768px) 50vw, 100vw"
                                    alt=""
                                />
                                <span class="example-body">
                                    <h3>{example.title}</h3>
                                    <p>{example.text}</p>
                                    <span class="example-tags">
                                        {example.tags.map((tag) => (
                                            <span>{tag}</span>
                                        ))}
                                    </span>
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
            <p class="examples-more">
                <a
                    class="btn default"
                    href="https://melonjs.github.io/melonJS/examples/"
                    role="button"
                    ><Icon icon="film" inline />Browse All Examples</a
                >
            </p>
        </div>

        <div>
            <h2 id="get-started">Get Started in Seconds</h2>
            <p>Scaffold a new project with a single command:</p>
            <div class="terminal" data-typing="40">
                <div class="terminal-bar">
                    <span class="terminal-dots" aria-hidden="true"
                        ><i></i><i></i><i></i></span
                    >
                    <span class="terminal-title">~</span>
                </div>
                <pre class="terminal-body"><code><span class="sh">$</span> npm create melonjs@latest my-game
<span class="out"><span class="ok">Done!</span> Created my-game.</span>
<span class="sh">$</span> cd my-game
<span class="sh">$</span> npm install
<span class="sh">$</span> npm run dev</code></pre>
            </div>
            <p>Or use the API directly for a quick Hello World:</p>
            <pre class="code-block"><code set:html={helloCode} /></pre>
        </div>

        <div class="platforms-section">
            <h2 id="platforms">Publish Anywhere</h2>
            <p>
                A melonJS game runs anywhere a browser does, and further: in
                game portals, in native apps, and in runtimes with no web page
                at all. The wiki has a guide for each, and melonJS hands
                pausing, saving and sound over to the platform the same way on
                every one of them.
            </p>
            <div class="why-cards platforms">
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3><span class="platform-icon"><img src="/img/platforms/web.svg" alt="" width="24" height="24" /></span><a href="https://github.com/melonjs/melonJS/wiki/Platforms">The Web</a></h3>
                    <p>Your own site, itch.io, or any host that serves a web page: a melonJS game is a web page.</p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3><span class="platform-icon"><img src="/img/platforms/youtube.svg" alt="" width="24" height="24" /></span><a href="https://github.com/melonjs/melonJS/wiki/YouTube-Playables">YouTube Playables</a></h3>
                    <p>Games in the YouTube app and on youtube.com, with cloud saves.</p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3><span class="platform-icon app"><img src="/img/platforms/poki.png" alt="" width="40" height="40" /></span><a href="https://github.com/melonjs/melonJS/wiki/Poki">Poki</a></h3>
                    <p>Hand-picked browser games on poki.com, on desktop and mobile.</p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3><span class="platform-icon app"><img src="/img/platforms/crazygames.png" alt="" width="40" height="40" /></span><a href="https://github.com/melonjs/melonJS/wiki/CrazyGames">CrazyGames</a></h3>
                    <p>Browser games on crazygames.com and in the CrazyGames app.</p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3><span class="platform-icon"><img src="/img/platforms/facebook.svg" alt="" width="24" height="24" /></span><a href="https://github.com/melonjs/melonJS/wiki/Facebook-Instant-Games">Facebook Instant Games</a></h3>
                    <p>Games in the Facebook app, on facebook.com/gaming and in Messenger.</p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3><span class="platform-icon"><img src="/img/platforms/wechat.svg" alt="" width="24" height="24" /></span><a href="https://github.com/melonjs/melonJS/wiki/WeChat-Mini-Games">WeChat Mini Games</a></h3>
                    <p>Mini games inside the WeChat app.</p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3><span class="platform-icon"><img src="/img/platforms/capacitor.svg" alt="" width="24" height="24" /></span><a href="https://github.com/melonjs/melonJS/wiki/Capacitor">iOS &amp; Android</a></h3>
                    <p>Native apps for the App Store and Google Play through Capacitor, with the official <a href="https://www.npmjs.com/package/@melonjs/capacitor-plugin">plugin</a>.</p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3><span class="platform-icon"><img src="/img/platforms/nxjs.svg" alt="" width="24" height="24" /></span><a href="https://github.com/melonjs/melonJS/wiki/Nintendo-Switch">Nintendo Switch Homebrew</a></h3>
                    <p>Through nx.js, a runtime with no web page at all (experimental).</p>
                </div>
            </div>
            <p>
                See <a href="https://github.com/melonjs/melonJS/wiki/Platforms">Platforms</a> in the wiki to
                get started.
            </p>
        </div>

        <div class="ai-section">
            <h2 id="ai-skills">AI Skills</h2>
            <p>
                melonJS ships 25 skills that teach a coding agent the engine's
                conventions, and the mistakes that fail silently rather than
                erroring: a custom <code>draw()</code> that ignores
                <code>this.pos</code>, <code>isKinematic</code> blocking pointer
                events, draw order set after <code>addChild</code>.
            </p>
            <p>Install them into whichever agent you use:</p>
            <div class="terminal" data-typing="18">
                <div class="terminal-bar">
                    <span class="terminal-dots" aria-hidden="true"
                        ><i></i><i></i><i></i></span
                    >
                    <span class="terminal-title">~/my-game</span>
                </div>
                <pre class="terminal-body"><code><span class="sh">$</span> npx skills add https://github.com/melonjs/melonJS/tree/master/packages/melonjs/skills
<span class="out">&#8226;  Found 25 skills</span>
<span class="out">&#8226;  Installing all 25 skills</span>
<span class="out">&#8226;  77 agents</span>
<span class="out">&#8226;  Installing to: Claude Code</span>

<span class="sh">$</span> claude
<span class="ask">&gt;</span> Add a bouncing crate with SAT collision to my Tiled level.</code></pre>
            </div>
            <p>
                One command, no config. The skills land in
                <code>.agents/skills/</code>, the shared location 77 agents read
                from, and the installer symlinks them into whatever else your
                editor expects, so nothing is placed by hand.
            </p>

            <div class="ai-routes">
                <div>
                    <h3><span class="platform-icon"><img src="/img/agents/claude.svg" alt="" width="24" height="24" /></span>Claude Code</h3>
                    <p>
                        Takes them as a plugin instead, registering the same
                        guidance as 25 routed skills.
                    </p>
                    <pre class="code-block wrap"><code>/plugin marketplace add melonjs/melonJS</code></pre>
                </div>
                <div>
                    <h3><span class="icon-group"><span class="platform-icon"><img src="/img/agents/chatgpt.svg" alt="" width="24" height="24" /></span><span class="platform-icon"><img src="/img/agents/cursor.svg" alt="" width="24" height="24" /></span><span class="platform-icon"><img src="/img/agents/gemini.svg" alt="" width="24" height="24" /></span></span>Codex, Cursor, Gemini CLI</h3>
                    <p>
                        Anything following the <code>AGENTS.md</code> convention
                        reads it from your project root. Copy the one that ships
                        with the package, or paste its sections into yours.
                    </p>
                    <pre class="code-block wrap"><code>cp node_modules/melonjs/skills/AGENTS.md .</code></pre>
                </div>
                <div>
                    <h3><span class="platform-icon"><img src="/img/agents/npm.svg" alt="" width="24" height="24" /></span>Pinned to Your Release</h3>
                    <p>
                        The command above installs from <code>master</code>. The
                        copy matching the version you depend on ships in the npm
                        package, one directory per subsystem.
                    </p>
                    <pre class="code-block wrap"><code>node_modules/melonjs/skills/</code></pre>
                </div>
            </div>

            <p>
                Then just describe what you want, as above. The
                <code>melonjs</code> skill routes to the guide that fits, out of
                physics, tilemaps, sprites, 3D scenes, lighting, shaders, audio,
                input, UI, performance and the rest, so your agent reads the one
                or two that matter rather than everything.
            </p>
        </div>

        <div class="compat">
            <Image
                class="right no-mobile"
                width={150}
                src={browserIcons}
                alt="Chrome, Firefox and Safari logos"
            />
            <h2 id="compatible">Compatibility</h2>
            <p>Compatible with all major browsers and mobile devices.</p>
            <p>
                The published bundle targets <strong>ES2022</strong>. A
                browser that does not support it cannot parse the file at
                all: loading fails with a syntax error and a blank screen,
                rather than breaking later when some feature runs.
            </p>
