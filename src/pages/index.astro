---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/variables.css'
import '../styles/index.css'
import Icon from '../components/Icon.astro'
import Carousel from '../components/Carousel.astro'
import gallery from '../carousels/gallery.json'

const scaffoldCode = `npm create melonjs@latest my-game
cd my-game
npm install
npm run dev`

const helloCode = `<span class="kw">import</span> { Application, Text } <span class="kw">from</span> <span class="str">"melonjs"</span>;

<span class="cmt">// create a new melonJS application</span>
<span class="kw">const</span> app = <span class="kw">new</span> Application(<span class="num">1218</span>, <span class="num">562</span>, {
    parent: <span class="str">"screen"</span>,
    scale: <span class="str">"auto"</span>,
});

<span class="cmt">// add a text display object</span>
app.world.addChild(<span class="kw">new</span> Text(<span class="num">609</span>, <span class="num">281</span>, {
    font: <span class="str">"Arial"</span>,
    size: <span class="num">160</span>,
    fillStyle: <span class="str">"#FFFFFF"</span>,
    textBaseline: <span class="str">"middle"</span>,
    textAlign: <span class="str">"center"</span>,
    text: <span class="str">"Hello World !"</span>,
}));`
---

<BaseLayout
    title="melonJS — A Modern & Lightweight HTML5 Game Engine"
    description="Build 2D games with melonJS, a free and open-source HTML5 game engine. Lightweight, fast WebGL rendering, Tiled map editor support, and zero dependencies. Under 100kb gzipped."
>
    <style>
        main {
            & h1,
            & h2,
            & h3,
            & h4,
            & h5,
            & h6 {
                margin-bottom: 1.5rem;
            }
            & > * {
                padding: var(--section-pad-y) var(--section-pad-x);
                &:nth-child(odd) {
                    background-color: var(--gray);
                    color: var(--white);
                    & h1,
                    & h2,
                    & h3,
                    & h4,
                    & h5,
                    & h6,
                    & a {
                        color: var(--light-green);
                    }
                }
                &:first-child {
                    & h1,
                    & h2,
                    & h3,
                    & h4,
                    & h5,
                    & h6,
                    & a {
                        color: var(--dark-green);
                    }
                }
            }
        }
    </style>
    <main>
        <div class="jumbotron">
            <div class="container">
                <Icon
                    icon="logo"
                    class="banner"
                    alt="melonjs banner"
                    width="80%"
                />
                <h1>A modern &amp; lightweight HTML5 game engine</h1>
                <p>
                    melonJS is an open-source HTML5 game engine for building
                    2D games with JavaScript and TypeScript. Lightweight,
                    dependency-free, and under 100kb gzipped.
                </p>
                <div class="badges">
                    <a href="https://www.npmjs.com/package/melonjs">
                        <img alt="npm version" src={`https://img.shields.io/npm/v/melonjs?style=flat-square&color=6ba832&label=npm`} height="20" />
                    </a>
                    <a href="https://github.com/melonjs/melonJS">
                        <img alt="GitHub stars" src={`https://img.shields.io/github/stars/melonjs/melonJS?style=flat-square&color=6ba832`} height="20" />
                    </a>
                    <a href="https://www.jsdelivr.com/package/npm/melonjs">
                        <img alt="jsDelivr hits" src={`https://img.shields.io/jsdelivr/npm/hm/melonjs?style=flat-square&color=6ba832&label=downloads`} height="20" />
                    </a>
                    <a href="https://github.com/melonjs/melonJS/blob/master/LICENSE">
                        <img alt="license MIT" src={`https://img.shields.io/badge/license-MIT-6ba832?style=flat-square`} height="20" />
                    </a>
                </div>
                <nav class="quick-start">
                    <ul>
                        <li>
                            <a
                                class="btn danger"
                                href="https://melonjs.github.io/melonJS/examples/#/platformer"
                                role="button"
                                ><Icon icon="film" inline />Demo
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn success"
                                href="/tutorial"
                                role="button"
                                ><Icon icon="flag" inline />Beginner's Tutorial
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn discord"
                                href="https://discord.gg/aur7JMk"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                <Icon icon="discord" class="inline" />Chat with
                                Us
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn default"
                                href="https://melonjs.github.io/melonJS/"
                                role="button"
                                ><Icon icon="book-open" inline />Explore the API
                            </a>
                        </li>
                        <li>
                            <a
                                class="btn primary"
                                href="https://melonjs.github.io/melonJS/examples/"
                                role="button"
                                ><Icon icon="film" inline />Examples
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
        <div class="row three highlights">
            <div>
                <h2>Fast</h2>
                <p>Modern ES6 architecture. WebGL renderer with Canvas fallback. Web Audio with 3D spatial sound.</p>
            </div>
            <div>
                <h2>Free</h2>
                <p>Released under the permissive MIT License. No cost. Forever.</p>
            </div>
            <div>
                <h2>Standalone</h2>
                <p>
                    Zero dependencies. Compatible with all major browsers
                    and mobile devices. Under
                    <a href="https://bundlephobia.com/result?p=melonjs@latest">100kb</a>
                    gzipped.
                </p>
            </div>
        </div>

        <div class="why-section">
            <h2 id="why">Why melonJS?</h2>
            <div class="why-cards">
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Canvas2D-Inspired API</h3>
                    <p>
                        The rendering system follows familiar HTML5 Canvas patterns &mdash;
                        <code>save</code>, <code>restore</code>, <code>translate</code>, <code>rotate</code>.
                        If you've used the Canvas API, you already know melonJS.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>True Renderer Abstraction</h3>
                    <p>
                        Write your game once, run it on WebGL or Canvas2D.
                        Automatic GPU fallback with zero code changes required.
                    </p>
                </div>
                <div class="why-card">
                    <div class="why-card-accent"></div>
                    <h3>Batteries Included</h3>
                    <p>
                        Physics, tilemaps, 3D mesh rendering, custom shaders, spatial audio,
                        particles and UI &mdash; all in one package with no external dependencies.
                    </p>
                </div>
            </div>
        </div>

        <div class="band">
            <h2>Powerful Level Design</h2>
            <p>
                Design your levels visually with the
                <a href="https://www.mapeditor.org">Tiled</a> map editor.
                melonJS natively supports orthogonal, isometric, and hexagonal
                maps with multiple layers, parallax scrolling, and more.
            </p>
            <br />
            <img
                src="/img/alex4-github.png"
                alt="melonJS level design with Tiled map editor showing platformer game"
                title="Fast and Powerful level design through Tiled"
                width="85%"
                height="85%"
                class="computer"
            />
        </div>

        <div>
            <h2 id="try-it">Try it Live</h2>
            <p>Jump right into a melonJS game &mdash; playable in your browser.</p>
            <div class="demo-embed">
                <iframe
                    src="https://melonjs.github.io/melonJS/examples/#/platformer"
                    title="melonJS platformer demo"
                    loading="lazy"
                    allowfullscreen
                ></iframe>
            </div>
        </div>

        <div>
            <h2 id="get-started">Get Started in Seconds</h2>
            <p>Scaffold a new project with a single command:</p>
            <pre class="code-block"><code set:html={scaffoldCode} /></pre>
            <p>Or use the API directly for a quick Hello World:</p>
            <pre class="code-block"><code set:html={helloCode} /></pre>
        </div>

        <div class="row two">
            <div>
                <h2 id="features">Features</h2>
                <ul>
                    <li>Fast WebGL &amp; Canvas rendering across desktop and mobile</li>
                    <li>Web Audio with 3D spatial sound</li>
                    <li>Sprites, animations, tinting, masking &amp; 2D lighting</li>
                    <li>Built-in 2D physics &amp; collision detection</li>
                    <li>Tiled map editor integration (orthogonal, isometric, hexagonal)</li>
                    <li>Multi-input: mouse, touch, keyboard, gamepad &amp; accelerometer</li>
                    <li>Camera system with effects (shake, fade, flash)</li>
                    <li>UI toolkit with drag-and-drop support</li>
                    <li>Tweens, transitions &amp; particle effects</li>
                    <li>3D mesh rendering with OBJ/MTL model loading &amp; depth testing</li>
                    <li>Custom shader effects for per-sprite WebGL rendering</li>
                    <li>State manager, asset loader &amp; plugin system</li>
                    <li>
                        Under <a
                            href="https://bundlephobia.com/result?p=melonjs@latest"
                        >100kb</a> gzipped &mdash; zero dependencies
                    </li>
                </ul>
            </div>

            <div>
                <img
                    class="right no-mobile"
                    width="150"
                    src="/img/icons/browser_icons.png"
                    alt="browser icons example"
                />
                <h2 id="compatible">Compatibility</h2>
                <p>Compatible with all major browsers and mobile devices</p>
                <table class="table browsers">
                    <thead>
                        <tr><th>Browser</th><th>Version</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th>
                                <a href="https://www.google.com/chrome/"
                                    >Chrome / Edge
                                </a>
                            </th>
                            <td>80+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th
                                ><a href="https://www.mozilla.com/">Firefox</a>
                            </th>
                            <td>80+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th
                                ><a href="https://www.apple.com/safari/"
                                    >Safari
                                </a>
                            </th>
                            <td>14+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th><a href="https://www.opera.com/">Opera</a></th>
                            <td>67+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th
                                ><a
                                    href="https://www.google.com/chrome/browser/mobile/"
                                    >Chrome Mobile
                                </a>
                            </th>
                            <td>80+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                        <tr>
                            <th
                                ><a href="https://www.apple.com/safari/"
                                    >iOS Safari
                                </a>
                            </th>
                            <td>14+</td>
                            <td
                                ><span class="check">&#10003;</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div>
            <h2>Developer Spotlight</h2>
            <div class="spotlight">
                <Carousel entries={gallery} />
            </div>
        </div>

        <div>
            <h2 id="third-party">Third Party Tools Integration</h2>
            melonJS provides native integration and support for the following 3rd
            party tools :
            <br />
            <ul class="display">
                <li>
                    <a href="https://www.mapeditor.org">
                        <img
                            alt="Tiled map editor"
                            src="https://user-images.githubusercontent.com/4033090/136762999-5a7f377b-4136-4205-9fe0-83728c90cb9b.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://www.codeandweb.com/texturepacker">
                        <img
                            alt="TexturePacker"
                            src="https://user-images.githubusercontent.com/4033090/136762472-bc55a638-c69b-4ff5-9d03-c684c8bea0ea.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://free-tex-packer.com">
                        <img
                            alt="Free Texture packer"
                            src="https://user-images.githubusercontent.com/4033090/136762061-1d3a0dfe-dbe0-4d3d-808d-47a49ecf5309.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://www.codeandweb.com/physicseditor">
                        <img
                            alt="Physics Editor"
                            src="https://user-images.githubusercontent.com/4033090/136762890-b1010c7f-cb19-4d35-a3f1-f5048db07835.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://renderhjs.net/shoebox/">
                        <img
                            alt="Shoebox"
                            src="https://user-images.githubusercontent.com/4033090/136762705-92027d94-d87c-4a95-b051-26647410248d.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="https://cordova.apache.org">
                        <img
                            alt="Cordova"
                            src="https://user-images.githubusercontent.com/4033090/136763147-6d157ce6-6921-437e-bb8f-0287b86109da.png"
                        />
                    </a>
                </li>
                <li>
                    <a href="http://esotericsoftware.com/">
                        <img alt="Spine" src="https://user-images.githubusercontent.com/4033090/261166742-7a8d81b8-bc80-47bd-80dc-d9a054c78c96.png">
                    </a>
                </li>
                <li>
                    <a href="https://www.aseprite.org/">
                        <img alt="aseprite" src="https://github.com/melonjs/melonJS/assets/4033090/65d19fef-2eba-461a-b925-cc2ad3bb270c">
                    </a>
                </li>
            </ul>
        </div>
        <footer class="band">
            <ul class="socials">
                <li>
                    <a
                        aria-label="NPM"
                        href="https://www.npmjs.com/package/melonjs"
                        ><Icon icon="npm" alt="npm" class="inline no-bump" />
                    </a>
                </li>
                <li>
                    <a href="https://discord.gg/aur7JMk" target="_blank" rel="noopener noreferrer"
                        ><Icon icon="discord" class="inline" />
                    </a>
                </li>
                <li>
                    <a href="https://github.com/melonjs/melonJS"
                        ><Icon icon="github" class="inline" /><span> </span>
                    </a>
                </li>
            </ul>
            <p>&#169; AltByte Pte Ltd</p>
            <p>
                <a href="https://www.altbyte.com"
                    ><img
                        src="https://user-images.githubusercontent.com/4033090/136692693-35dca8aa-5012-4a37-9ea2-51640d2e6d73.png"
                        alt="AltByte"
                        height="32"
                    /></a
                >
            </p>
        </footer>
    </main>
</BaseLayout>
