---
import Icon from './Icon.astro'
import '../styles/global.css'
import '../styles/header.css'
const pathname = new URL(Astro.request.url).pathname
---

<header>
    <nav aria-label="Main">
        <a class="brand" href="/#top" aria-current={pathname === '/' ? 'page' : undefined}
            ><Icon icon="favicon" class="brand-icon" /><span>melonJS</span></a
        >
        <ul>
            <li>
                <a href="https://melonjs.github.io/melonJS/examples/">Examples</a>
            </li>
            <li class={pathname.startsWith('/tutorial') ? 'active' : null}>
                <a
                    href="/tutorial"
                    aria-current={pathname.startsWith('/tutorial') ? 'page' : undefined}
                    >Tutorial</a
                >
            </li>
            <li><a href="https://github.com/melonjs/melonJS/wiki">Wiki</a></li>
            <li><a href="https://melonjs.github.io/melonJS/">API</a></li>
            <li>
                <a href="https://github.com/melonjs/melonJS" aria-label="GitHub"
                    ><Icon icon="github" class="github-icon" /><span class="label"
                        >GitHub</span
                    ></a
                >
            </li>
        </ul>
    </nav>
</header>
