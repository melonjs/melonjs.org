---
// Hands the current page to an AI assistant: as Markdown on the clipboard, or
// as a URL prefilled into a new chat.
---

<div class="copy-page" data-copy-page>
    <button
        type="button"
        class="copy-toggle"
        data-copy-toggle
        aria-haspopup="true"
        aria-expanded="false"
    >
        <span data-copy-label>Copy page</span>
        <span class="copy-caret" aria-hidden="true"></span>
    </button>
    <ul class="copy-menu" data-copy-menu hidden>
        <li>
            <button type="button" data-copy-action="markdown">
                Copy as Markdown
                <small>This page as text, with its URL attached</small>
            </button>
        </li>
        <li>
            <a data-copy-action="chatgpt" href="#" rel="noopener noreferrer">
                Open in ChatGPT
                <small>New chat, this page's URL filled in</small>
            </a>
        </li>
        <li>
            <a data-copy-action="claude" href="#" rel="noopener noreferrer">
                Open in Claude
                <small>New chat, this page's URL filled in</small>
            </a>
        </li>
    </ul>
</div>

<style>
    .copy-page {
        position: relative;
        display: inline-block;
        text-align: left;
        font-size: 0.9rem;
    }

    .copy-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        font: inherit;
        color: inherit;
        cursor: pointer;
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.18);
        border-radius: 8px;
        transition:
            background 0.2s ease,
            border-color 0.2s ease;
    }

    .copy-toggle:hover,
    .copy-toggle[aria-expanded='true'] {
        background: rgba(255, 255, 255, 0.12);
        border-color: rgba(107, 168, 50, 0.5);
    }

    .copy-caret {
        border-top: 0.35em solid currentColor;
        border-right: 0.3em solid transparent;
        border-left: 0.3em solid transparent;
        opacity: 0.7;
    }

    .copy-menu {
        position: absolute;
        top: calc(100% + 0.5rem);
        right: 0;
        z-index: 50;
        min-width: 17rem;
        margin: 0;
        padding: 0.35rem;
        list-style: none;
        background: var(--dark-gray);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: 10px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.45);
    }

    /* An author `display` rule beats the UA stylesheet's [hidden], so without
       this the menu stays painted while the attribute toggles correctly. */
    .copy-menu[hidden] {
        display: none;
    }

    .copy-menu li + li {
        margin-top: 0.15rem;
    }

    .copy-menu button,
    .copy-menu a {
        display: block;
        width: 100%;
        padding: 0.55rem 0.7rem;
        font: inherit;
        text-align: left;
        text-decoration: none;
        color: var(--white);
        background: none;
        border: 0;
        border-radius: 7px;
        cursor: pointer;
    }

    .copy-menu button:hover,
    .copy-menu a:hover,
    .copy-menu button:focus-visible,
    .copy-menu a:focus-visible {
        background: rgba(255, 255, 255, 0.08);
        color: var(--light-green);
    }

    .copy-menu small {
        display: block;
        margin-top: 0.15rem;
        font-size: 0.78rem;
        opacity: 0.65;
    }
</style>

<script>
    const ABSOLUTE = /^[a-z][a-z0-9+.-]*:/i

    /** The page's canonical URL, falling back to where the browser actually is. */
    function pageUrl() {
        const canonical = document.querySelector<HTMLLinkElement>(
            'link[rel="canonical"]',
        )
        return canonical?.href || location.href
    }

    function inlineText(node: Node): string {
        if (node.nodeType === Node.TEXT_NODE) {
            return (node.textContent || '').replace(/\s+/g, ' ')
        }
        if (node.nodeType !== Node.ELEMENT_NODE) return ''

        const el = node as HTMLElement
        const inner = () =>
            Array.from(el.childNodes).map(inlineText).join('')

        switch (el.tagName) {
            case 'BR':
                return '\n'
            case 'CODE':
                return `\`${el.textContent?.replace(/\s+/g, ' ').trim()}\``
            case 'STRONG':
            case 'B':
                return `**${inner().trim()}**`
            case 'EM':
            case 'I':
                return `*${inner().trim()}*`
            case 'A': {
                const href = (el as HTMLAnchorElement).getAttribute('href') || ''
                const url = ABSOLUTE.test(href)
                    ? href
                    : new URL(href, location.href).href
                return `[${inner().trim()}](${url})`
            }
            case 'IMG': {
                const img = el as HTMLImageElement
                return `![${img.alt || ''}](${img.src})`
            }
            default:
                return inner()
        }
    }

    const SKIP = new Set([
        'SCRIPT',
        'STYLE',
        'NOSCRIPT',
        'IFRAME',
        'SVG',
        'HEADER',
        'NAV',
        'FOOTER',
        'BUTTON',
    ])

    function blocks(el: Element, out: string[], indent = '') {
        for (const child of Array.from(el.children)) {
            const tag = child.tagName
            if (SKIP.has(tag) || child.closest('[data-copy-page]')) continue

            if (/^H[1-6]$/.test(tag)) {
                const level = Number(tag[1])
                out.push(`${'#'.repeat(level)} ${inlineText(child).trim()}`)
            } else if (tag === 'P') {
                const text = inlineText(child).trim()
                if (text) out.push(indent + text)
            } else if (tag === 'PRE') {
                const code = (child.textContent || '').replace(/\s+$/, '')
                out.push('```\n' + code + '\n```')
            } else if (tag === 'UL' || tag === 'OL') {
                let n = 1
                for (const li of Array.from(child.children)) {
                    if (li.tagName !== 'LI') continue
                    const marker = tag === 'OL' ? `${n++}.` : '-'
                    const own = Array.from(li.childNodes)
                        .filter(
                            (node) =>
                                !(
                                    node.nodeType === Node.ELEMENT_NODE &&
                                    ['UL', 'OL'].includes(
                                        (node as Element).tagName,
                                    )
                                ),
                        )
                        .map(inlineText)
                        .join('')
                        .trim()
                    if (own) out.push(`${indent}${marker} ${own}`)
                    const nested = li.querySelector(':scope > ul, :scope > ol')
                    if (nested) blocks(li, out, indent + '  ')
                }
            } else if (tag === 'BLOCKQUOTE') {
                const text = inlineText(child).trim()
                if (text) out.push(`> ${text}`)
            } else {
                blocks(child, out, indent)
            }
        }
    }

    function pageMarkdown() {
        const main = document.querySelector('main')
        const out: string[] = []
        if (main) blocks(main, out)
        const title = document.title.trim()
        return [`# ${title}`, `Source: ${pageUrl()}`, ...out].join('\n\n')
    }

    function assistantLink(base: string) {
        const q = `Read ${pageUrl()} and help me build with melonJS.`
        return `${base}?q=${encodeURIComponent(q)}`
    }

    for (const wrap of Array.from(
        document.querySelectorAll<HTMLElement>('[data-copy-page]'),
    )) {
        const toggle = wrap.querySelector<HTMLButtonElement>('[data-copy-toggle]')
        const menu = wrap.querySelector<HTMLElement>('[data-copy-menu]')
        const label = wrap.querySelector<HTMLElement>('[data-copy-label]')
        const copy = wrap.querySelector<HTMLButtonElement>(
            '[data-copy-action="markdown"]',
        )
        const chatgpt = wrap.querySelector<HTMLAnchorElement>(
            '[data-copy-action="chatgpt"]',
        )
        const claude = wrap.querySelector<HTMLAnchorElement>(
            '[data-copy-action="claude"]',
        )
        if (!toggle || !menu) continue

        chatgpt?.setAttribute('href', assistantLink('https://chatgpt.com/'))
        chatgpt?.setAttribute('target', '_blank')
        claude?.setAttribute('href', assistantLink('https://claude.ai/new'))
        claude?.setAttribute('target', '_blank')

        const open = () => {
            menu.hidden = false
            toggle.setAttribute('aria-expanded', 'true')
        }
        const close = () => {
            menu.hidden = true
            toggle.setAttribute('aria-expanded', 'false')
        }

        toggle.addEventListener('click', () => {
            menu.hidden ? open() : close()
        })

        // Containment test rather than stopPropagation on the toggle, so
        // closing does not depend on the order listeners happen to run in.
        document.addEventListener('click', (event) => {
            const target = event.target
            if (target instanceof Node && !wrap.contains(target)) close()
        })

        document.addEventListener('keydown', (event) => {
            if (event.key === 'Escape') close()
        })

        copy?.addEventListener('click', async () => {
            const text = pageMarkdown()
            try {
                await navigator.clipboard.writeText(text)
            } catch {
                const area = document.createElement('textarea')
                area.value = text
                area.setAttribute('readonly', '')
                area.style.position = 'fixed'
                area.style.opacity = '0'
                document.body.appendChild(area)
                area.select()
                document.execCommand('copy')
                area.remove()
            }
            if (label) {
                label.textContent = 'Copied'
                setTimeout(() => (label.textContent = 'Copy page'), 1600)
            }
            close()
        })
    }
</script>
