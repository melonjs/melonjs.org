---
import BaseLayout from './BaseLayout.astro'
import '../styles/markdown.css'

// A Markdown/MDX page passes its frontmatter as `Astro.props.frontmatter`;
// TutorialLayout nests inside this one and forwards title/description directly.
const {
    frontmatter,
    title = frontmatter?.title,
    description = frontmatter?.description,
} = Astro.props
---

<BaseLayout {title} {description}>
    <main class="md"><slot /></main>
</BaseLayout>
