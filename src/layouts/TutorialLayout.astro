---
import MDLayout from './MDLayout.astro'
import '../styles/markdown.css'
import '../styles/tutorial.css'

const pathname = new URL(Astro.request.url).pathname
const {
    frontmatter,
    title = frontmatter?.title,
    description = frontmatter?.description,
} = Astro.props
---

<MDLayout {title} {description}>
    <style>
        .tutorial-home {
            margin-bottom: -5vmin;
        }
    </style>
    {
        pathname === '/tutorial' ? null : (
            <a class="tutorial-home" href="/tutorial">
                Tutorial: Hacking a Platformer Game
            </a>
        )
    }
    <slot />
</MDLayout>
